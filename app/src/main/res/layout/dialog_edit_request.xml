<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Vehicle Type Dropdown -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilEditVehicle"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Vehicle Type"
        app:startIconDrawable="@drawable/ic_help_question"
        app:startIconTint="@color/primary_orange">

        <AutoCompleteTextView
            android:id="@+id/actvEditVehicle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:textSize="15sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Fuel Type Dropdown -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilEditFuel"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Fuel Type"
        app:startIconDrawable="@drawable/ic_help_question"
        app:startIconTint="@color/primary_orange">

        <AutoCompleteTextView
            android:id="@+id/actvEditFuel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:textSize="15sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Quantity Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilEditQuantity"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Quantity (Liters / kWh)"
        app:startIconDrawable="@drawable/ic_help_question"
        app:startIconTint="@color/primary_orange">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEditQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:textSize="15sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Issue Description Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilEditIssue"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Issue Description"
        app:startIconDrawable="@drawable/ic_help_question"
        app:startIconTint="@color/primary_orange">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEditIssue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textLongMessage|textCapSentences"
            android:maxLines="3"
            android:textSize="15sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Location Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilEditLocation"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Current Location / Address"
        app:startIconDrawable="@drawable/ic_email"
        app:startIconTint="@color/primary_orange">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEditLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPostalAddress|textCapWords"
            android:maxLines="2"
            android:textSize="15sp" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
